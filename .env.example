# Copy to .env.local and fill from Supabase: Project Settings → API
#
# Cloud backup uses Supabase Auth (email). Enable Email in Authentication → Providers.
# Magic links: set Site URL / redirect URLs to your app origin (e.g. http://localhost:3000).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
